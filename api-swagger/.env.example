# Пример окружения бэкенда. Скопируй в .env и подставь свои значения:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# Файл .env в git не коммитится.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=petstore
# true — авто-схема (быстрые эксперименты). false — схемой управляют миграции (рекомендуется).
DB_SYNCHRONIZE=false

# --- Аутентификация ---
# Длинная случайная строка, напр.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret

# --- Администратор (создаётся/обновляется автоматически при старте) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password

# --- Файлы ---
# Каталог загрузок. В Docker — /app/uploads, локально (в т.ч. Windows) — ./uploads
UPLOAD_DIR=./uploads

# --- Фронтенд ---
# База фронтенда — для ссылки восстановления пароля (dev-stub логирует/возвращает её)
FRONTEND_URL=http://localhost:5173
